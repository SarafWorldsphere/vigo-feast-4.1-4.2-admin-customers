"""Configuration for the integrated Module 4.4 API.

Uses the same DB_* environment variables as the existing FastAPI Admin Console.
DATABASE_URL may be set explicitly if the deployment already uses one.
"""

import os
from urllib.parse import quote_plus


class Settings:
    app_name = os.getenv("APP_NAME", "VIGO FEAST Admin Console")
    app_env = os.getenv("APP_ENV", "production").strip().lower() or "production"
    app_version = os.getenv("APP_VERSION", "1.0.0")
    db_schema = os.getenv("DB_SCHEMA", "public")
    db_table_prefix = os.getenv("DB_TABLE_PREFIX", "vgf_")
    default_page_size = int(os.getenv("DEFAULT_PAGE_SIZE", "20"))
    max_page_size = int(os.getenv("MAX_PAGE_SIZE", "100"))

    @property
    def database_url(self) -> str:
        explicit = os.getenv("DATABASE_URL", "").strip()
        if explicit:
            return explicit
        host = os.getenv("DB_HOST", "localhost")
        port = os.getenv("DB_PORT", "5432")
        name = os.getenv("DB_NAME", "FDS_prod")
        user = quote_plus(os.getenv("DB_USER", "swais_app_user"))
        password = quote_plus(os.getenv("DB_PASSWORD", ""))
        return f"postgresql+psycopg://{user}:{password}@{host}:{port}/{name}"


settings = Settings()
